{
  "name": "ai-knowledge-inbox",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @aki/api --filter @aki/web dev",
    "build": "bun run --filter @aki/shared build && bun run --filter @aki/api --filter @aki/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "bun run --filter '*' test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
